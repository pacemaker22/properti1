# Salin file ini menjadi .env.local, lalu isi nilai dari Supabase > Project Settings > API.
# Hanya anon / publishable key yang boleh di sini. Jangan taruh service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opsional: base URL kanonik untuk SEO (mis. https://properti1.com).
VITE_SITE_URL=
# Opsional: URL absolut gambar Open Graph default.
VITE_OG_IMAGE_URL=
